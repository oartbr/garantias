{
  "name": "garantias",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-pwa.mjs",
    "build:e2e": "node scripts/test-app.mjs build",
    "start": "next start",
    "lint": "eslint src",
    "prepare": "is-ci || husky",
    "release": "release-it",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.isolated.config.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "playwright test -c playwright.integrated.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.0.8",
    "@hookform/resolvers": "^3.2.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@react-oauth/google": "^0.12.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-query-devtools": "5.104.4",
    "@vercel/blob": "^2.8.2",
    "@yudiel/react-qr-scanner": "2.6.0",
    "accept-language": "^3.0.18",
    "countries-list": "^3.1.0",
    "country-list": "^2.3.0",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "firebase": "^13.0.0",
    "i18next": "23.11.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-resources-to-backend": "^1.1.4",
    "js-cookie": "^3.0.5",
    "nanoid": "^5.0.1",
    "next": "16.4.2",
    "notistack": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "7.90.0",
    "react-i18next": "^14.0.0",
    "react-select": "5.10.2",
    "react-virtuoso": "4.18.19",
    "twilio": "^5.2.0",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.64.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/country-list": "^2.1.4",
    "@types/imap": "^0.8.40",
    "@types/js-cookie": "^3.0.3",
    "@types/mailparser": "^3.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "husky": "^9.0.10",
    "imap": "^0.8.19",
    "is-ci": "^3.0.1",
    "jsdom": "30.1.3",
    "mailparser": "^3.7.0",
    "prettier": "^3.2.5",
    "release-it": "^21.1.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance Improvements"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Code Refactoring"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "ci",
              "section": "Continuous Integration"
            }
          ]
        }
      }
    }
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "serialize-javascript": "7.0.5"
  }
}
